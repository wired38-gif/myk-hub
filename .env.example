# Queens Customs Admin Portal — environment variables
# Copy to .env in the GoDaddy application settings or as a file on the server.
# Never commit the actual .env to git.

# Required: JWT signing secret — use a long random string
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret

# Optional: override master admin seed credentials (defaults shown)
ADMIN_SEED_EMAIL=mike@myk.com
ADMIN_SEED_PASSWORD=87188718

# GoDaddy sets PORT automatically — do not override in production
# PORT=20010
